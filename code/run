#!/usr/bin/env bash
set -euxo pipefail

render_html() {
  local script="$1"
  local outname
  outname="$(basename "${script%.R}").html"
  Rscript -e "
    source('/code/setup.R')

    .knitr_state <- new.env(parent = emptyenv())
    .knitr_state\$fig_dir <- tempfile('figures')
    dir.create(.knitr_state\$fig_dir)

    knitr::opts_chunk\$set(
      fig.path   = paste0(.knitr_state\$fig_dir, '/fig-'),
      fig.width  = 14,
      fig.height = 10,
      fig.retina = 2,
      out.width  = '100%'
    )

    .knitr_state\$rmd <- knitr::spin('$script', knit = FALSE, format = 'Rmd')
    .knitr_state\$md  <- knitr::knit(.knitr_state\$rmd, quiet = FALSE)

    system2('pandoc', c(
      .knitr_state\$md,
      '-o', '/results/$outname',
      '--standalone',
      '--embed-resources',
      '--metadata', 'title=$script'
    ))

    unlink(.knitr_state\$fig_dir, recursive = TRUE)
    suppressWarnings(file.remove(.knitr_state\$rmd, .knitr_state\$md))
  "
}

render_html 2_BARseq_norm_cluster_analyze_brain3.R
echo "brain3 BARseq exit code: $?"
render_html 2_BARseq_norm_cluster_analyze_brain4.R
echo "brain4 BARseq exit code: $?"

render_html 3_MAPseq_match_BARseq_brain3.R
echo "brain3 MAPseq match exit code: $?"
render_html 3_MAPseq_match_BARseq_brain4.R
echo "brain4 MAPseq match exit code: $?"

render_html 4_MAPseq_Klebschull_replicate_CTX_proj_brain3.R
echo "brain3 MAPseq ctx check exit code: $?"
render_html 4_MAPseq_Klebschull_replicate_CTX_proj_brain4.R
echo "brain4 MAPseq ctx check exit code: $?"

render_html 5_MAPseq_probability_brain3.R
echo "brain3 MAPseq probability exit code: $?"
render_html 5_MAPseq_probability_brain4.R
echo "brain4 MAPseq probability exit code: $?"
render_html 5_MAPseq_probability_brain3-4_combined.R
echo "brain3-4 combined MAPseq probability exit code: $?"

render_html 6_MAPseq_ExA-SPIM_brain3.R
echo "brain3 MAPseq ExA plots exit code: $?"
render_html 6_MAPseq_ExA-SPIM_brain4.R
echo "brain4 MAPseq ExA plots exit code: $?"
render_html 6_MAPseq_ExA-SPIM_brain3-4_combined.R
echo "brain3-4 combined MAPseq ExA plots exit code: $?"

# TEMP — remove before merge along with TEMP_validate_against_reference.R and the reference data asset.
render_html TEMP_validate_against_reference.R
echo "validation exit code: $?"

echo "=== Reproducible Run complete. HTML reports saved to /results/ ==="
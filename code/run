#!/usr/bin/env bash
set -euxo pipefail

render_html() {
  local script="$1"
  local outname
  outname="$(basename "${script%.R}").html"
  Rscript -e "
    setup_chunk <- c(
      '#+ setup, echo=FALSE, message=FALSE, warning=FALSE, include=FALSE',
      'source(\"setup.R\")',
      ''
    )
    lines <- readLines('$script')
    tmp <- tempfile(fileext = '.R')
    writeLines(c(setup_chunk, lines), tmp)
    rmd <- knitr::spin(tmp, knit = FALSE, format = 'Rmd')
    on.exit({
      suppressWarnings(file.remove(tmp))
      suppressWarnings(file.remove(rmd))
    })
    rmarkdown::render(rmd,
      output_format = 'html_document',
      output_file   = '$outname',
      output_dir    = '/results/')
  "
}

# Add one render_html call per script
render_html 2_BARseq_norm_cluster_analyze_brain3.R
render_html 2_BARseq_norm_cluster_analyze_brain4.R
render_html 2_BARseq_norm_cluster_analyze_brain3-4_combined.R
#render_html 2_BARseq_norm_cluster_analyze_brain4.R

echo "=== Reproducible Run complete. HTML reports saved to /results/ ==="
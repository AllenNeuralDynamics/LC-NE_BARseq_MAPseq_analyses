#!/usr/bin/env bash
set -euxo pipefail

render_html() {
  local script="$1"
  local outname
  outname="$(basename "${script%.R}").html"
  Rscript -e "
    source('/code/setup.R')

    .knitr_state <- new.env(parent = emptyenv())
    .knitr_state\$fig_dir <- tempfile('figures')
    dir.create(.knitr_state\$fig_dir)

    knitr::opts_chunk\$set(
      fig.path   = paste0(.knitr_state\$fig_dir, '/fig-'),
      fig.width  = 14,
      fig.height = 10,
      fig.retina = 2,
      out.width  = '100%'
    )

    .knitr_state\$rmd <- knitr::spin('$script', knit = FALSE, format = 'Rmd')
    .knitr_state\$md  <- knitr::knit(.knitr_state\$rmd, quiet = FALSE)

    system2('pandoc', c(
      .knitr_state\$md,
      '-o', '/results/$outname',
      '--standalone',
      '--embed-resources',
      '--metadata', 'title=$script'
    ))

    unlink(.knitr_state\$fig_dir, recursive = TRUE)
    suppressWarnings(file.remove(.knitr_state\$rmd, .knitr_state\$md))
  "
}

render_html 2_BARseq_norm_cluster_analyze_brain3.R
echo "brain3 exit code: $?"
render_html 2_BARseq_norm_cluster_analyze_brain4.R

echo "=== Reproducible Run complete. HTML reports saved to /results/ ==="
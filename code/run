#!/usr/bin/env bash
set -euxo pipefail

render_html() {
  local script="$1"
  local outname
  outname="$(basename "${script%.R}").html"
  Rscript -e "
    # Load all libraries in THIS session
    source('/code/setup.R')

    # Figures go to a temp dir; pandoc --self-contained will embed them as base64
    fig_dir <- tempfile('figures')
    dir.create(fig_dir)
    knitr::opts_chunk\$set(fig.path = paste0(fig_dir, '/fig-'))

    # spin: .R -> .Rmd (text transform only, no execution)
    rmd <- knitr::spin('$script', knit = FALSE, format = 'Rmd')

    # knit: .Rmd -> .md, runs IN THIS SESSION (no new R process spawned)
    md <- knitr::knit(rmd, quiet = FALSE)

    # pandoc: .md -> standalone self-contained HTML
    system2('pandoc', c(
      md,
      '-o', '/results/$outname',
      '--standalone',
      '--self-contained',
      '--metadata', 'title=$script'
    ))

    # cleanup
    unlink(fig_dir, recursive = TRUE)
    suppressWarnings(file.remove(rmd, md))
  "
}

render_html 01_your_script.R
render_html 02_your_script.R
# ...

echo "=== Reproducible Run complete. HTML reports saved to /results/ ==="
{
	"version": 1,
	"base_image": "codeocean/c2-seurat:latest",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true
	},
	"installers": {
		"mamba": {
			"packages": [
				{
					"name": "r-base",
					"version": "4.3.0"
				}
			]
		},
		"rbioconductor": {
			"packages": [
				{
					"name": "BiocVersion",
					"version": "3.18.1"
				},
				{
					"name": "IRanges",
					"version": "2.36.0"
				},
				{
					"name": "scater",
					"version": "1.30.1"
				}
			],
			"r_version": "4.3.1",
			"install_bioconductor": true
		}
	}
}